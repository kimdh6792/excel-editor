{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excel Editor",
  "version": "0.1.0",
  "identifier": "com.kdh.excel-editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Excel Editor",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["xlsx", "xlsm"],
        "name": "Excel Workbook",
        "description": "Excel 통합 문서",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": ["csv", "tsv"],
        "name": "Delimited Text",
        "description": "구분자 텍스트",
        "role": "Viewer",
        "mimeType": "text/csv"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
